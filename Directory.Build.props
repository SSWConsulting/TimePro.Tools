<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The runtime runs async methods itself instead of through compiler-generated
         state machines: less overhead per await and readable async stack traces.
         .NET 11 still makes it opt-in. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
</Project>
